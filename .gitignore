/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/custom/
!/design/
!/gateway/
!/client/
!/wiki-pages/
!/deploy/
!/skills/
!/brand/

# Never version: contains the database password and secret keys
LocalSettings.php
