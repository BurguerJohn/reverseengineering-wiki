# ReverseEngineering.wiki gateway configuration. Copy to .env (never commit .env).

# HTTP server. The gateway listens on HOST:PORT behind the web server, which proxies
# /mcp, /auth/, /dumps, /health, /client/, /llms.txt and /.well-known/mcp.json on the
# wiki's own domain (deploy/apache-vhost.conf). PUBLIC_URL is that shared site URL.
HOST=127.0.0.1
PORT=8787
PUBLIC_URL=http://wikivibe.test
# 1 when behind the reverse proxy (it sets X-Forwarded-For); only safe with HOST=127.0.0.1
TRUST_PROXY=1

# 32+ random bytes (base64url). Encrypts emails/MediaWiki passwords, keys HMACs.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GATEWAY_SECRET=
# Shared with MediaWiki ($wgREWikiWebLoginSecret in LocalSettings.php) for the wiki's email-code login.
WEB_LOGIN_SECRET=

DATA_DIR=./data

# MediaWiki
MW_API_URL=http://wikivibe.test/api.php
MW_PUBLIC_URL=http://wikivibe.test
MW_GATEWAY_USER=REWiki Gateway
MW_GATEWAY_PASSWORD=
# Used by dumps (php maintenance/run.php dumpBackup)
MW_DIR=..
PHP_BIN=php

# Email — the only place that decides how email is sent (docs/08-accounts-and-auth.md#email-delivery)
# Driver: smtp | log
MAIL_DRIVER=smtp
MAIL_FROM="ReverseEngineering.wiki <no-reply@wikivibe.test>"
MAIL_REPLY_TO=
# Development: Laragon's Mailpit (inbox at http://localhost:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Index and dumps
INDEX_POLL_SECONDS=5
DUMP_DIR=./data/dumps
# 0 disables the built-in scheduler (run "npm run cli -- dump" from cron instead)
DUMP_INTERVAL_HOURS=24

# Version of the content policy + licenses accepted at registration
TERMS_VERSION=2026-10-15
